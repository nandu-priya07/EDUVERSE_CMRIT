HOST=127.0.0.1
PORT=8000

# LLM Configuration
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
USE_FALLBACK_LLM_PROMPT=true

# Image Generator Configuration
IMAGE_MODEL=stabilityai/sdxl-turbo
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
IMAGE_STEPS=4
IMAGE_GUIDANCE_SCALE=0.0

# Hardware & VRAM Optimization Settings
USE_CUDA=true
USE_FP16=true
USE_CPU_OFFLOAD=true
ENABLE_ATTENTION_SLICING=true

# Limits & Storage
MAX_PANELS=8
MAX_INPUT_SIZE_MB=50
