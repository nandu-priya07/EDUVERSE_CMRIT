# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Database Credentials
DATABASE_URL=postgresql://postgres.your_user:your_password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
SUPABASE_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.your_project_ref
SUPABASE_PASSWORD=your_supabase_password

# Authentication JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
