# PDFMind Configuration
APP_NAME=PDFMind
DEBUG=true

# Embedding Model (Runs locally via sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Text Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# Retrieval Settings
RETRIEVAL_TOP_K=4

# LLM Configuration
# Providers supported: gemini, openai, local-extractive
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Storage Paths (relative to backend directory or absolute)
CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data
